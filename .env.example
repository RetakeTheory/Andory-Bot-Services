# Public Bot adapter settings. Copy to .env and fill locally; never commit .env.
BOT_WS_URL=wss://api.example.com/ws/bot?channel=main&protocol=custom
BOT_WS_TOKEN=replace-with-a-long-random-secret
ADMIN_BOOTSTRAP_TOKEN=replace-with-a-separate-one-time-admin-secret
AUTH_ENCRYPTION_KEY=replace-with-a-random-32-byte-or-longer-secret

# Values extracted from an authorized matching game build; enter at runtime.
HOLODORI_MARSHAL_SECRET=replace-with-local-value
HOLODORI_SIGNING_KEY=replace-with-local-value
HOLODORI_APP_VERSION=1.1.0
HOLODORI_DEVICE_NAME=iPhone
HOLODORI_OS_VERSION=iOS 18

# Optional regional overrides (keep JP/global values separate).
HOLODORI_JP_ADDRESS=
HOLODORI_GLOBAL_ADDRESS=
HOLODORI_JP_PROXY=
HOLODORI_GLOBAL_PROXY=
HOLODORI_PROXY_TOKEN=
ANDORY_IL2CPP_DUMPER=C:\\path\\to\\Il2CppDumper.exe
ANDORY_PYTHON=python
