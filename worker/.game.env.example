# Values extracted from the matching decrypted IPA. Keep JP/global sessions separate.
HOLODORI_MARSHAL_SECRET=
HOLODORI_SIGNING_KEY=
HOLODORI_APP_VERSION=1.1.0
HOLODORI_DEVICE_NAME=iPhone
HOLODORI_OS_VERSION=iOS 18
HOLODORI_INTEGRITY_DEBUGGER=False
HOLODORI_INTEGRITY_GAME_GUARDIAN=False
HOLODORI_INTEGRITY_JAILBREAK=False
HOLODORI_INTEGRITY_INJECTED_LIBRARIES=
# Only set when the IPA contains embedded.mobileprovision and the native client
# produces a DeveloperCertificates value.
HOLODORI_INTEGRITY_SIGNATURE=

# Region-specific headers extracted from each IPA. Defaults already match the
# corresponding iOS bundle and can normally be left blank.
HOLODORI_JP_BUNDLE_ID=game.qualiarts.hololive.dreams.jp
HOLODORI_JP_LANGUAGE=jpn
HOLODORI_GLOBAL_BUNDLE_ID=game.qualiarts.hololive.dreams.com
HOLODORI_GLOBAL_LANGUAGE=eng

# Optional DNS workaround. Leave blank under normal network conditions.
HOLODORI_JP_ADDRESS=
HOLODORI_GLOBAL_ADDRESS=

# Optional authenticated Worker transport when the local network is rejected
# by the game's regional edge. Keep the JP and global bases separate.
HOLODORI_JP_PROXY=
HOLODORI_GLOBAL_PROXY=https://api.rettheory.top/internal/game/global
HOLODORI_PROXY_TOKEN=

# Optional overrides. Automatic event discovery is used when these are blank.
HOLODORI_JP_CHAPTER_ID=
HOLODORI_JP_MUSIC_ID=
HOLODORI_GLOBAL_CHAPTER_ID=
HOLODORI_GLOBAL_MUSIC_ID=
