{
  "name": "holodori-rank-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "wrangler types && tsc --noEmit",
    "dev": "wrangler dev --local",
    "deploy:dry": "wrangler deploy --dry-run",
    "deploy": "wrangler deploy",
    "test": "node --env-file-if-exists=.dev.vars test/ws-smoke.mjs",
    "test:onebot": "node --env-file-if-exists=.dev.vars test/onebot-smoke.mjs",
    "test:speed": "node test/speed.mjs",
    "test:render": "node test/render-preview.mjs",
    "bot:game": "node --env-file-if-exists=.dev.vars --env-file-if-exists=.game.env examples/game-data-bot.mjs",
    "probe:game": "node --env-file-if-exists=.game.env examples/game-probe.mjs",
    "build:launchers": "node scripts/build-standalone-launchers.mjs"
  },
  "dependencies": {
    "@7mind.io/sqlcipher-wasm": "1.2.0",
    "@resvg/resvg-js": "2.6.2",
    "sharp": "0.35.2"
  },
  "devDependencies": {
    "postject": "1.0.0-alpha.6",
    "tar-stream": "3.1.7",
    "typescript": "7.0.2",
    "wrangler": "4.125.0"
  }
}
